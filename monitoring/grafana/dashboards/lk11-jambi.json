    },
    {
      "id": 3,
      "title": "Throughput per replica",
      "description": "Actual observed inference requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lk11-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance)(rate(lk11_inference_requests_total{job=\"mlflow-model\"}[30s]))",
          "legendFormat": "{{instance}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lk11-prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "Inference latency p95",
      "description": "Proxy-to-MLflow round-trip; histogram estimate",
