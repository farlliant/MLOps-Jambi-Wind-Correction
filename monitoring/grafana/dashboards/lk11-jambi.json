{
  "uid": "lk11-jambi",
  "title": "LK11 | Jambi Wind Model Observability",
  "tags": [
    "MLOps",
    "LK11",
    "synthetic-demo"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Healthy scrape targets",
      "description": "Target: 3 healthy replicas",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "lk11-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"mlflow-model\"})",
          "legendFormat": "{{instance}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lk11-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Drift flags per replica",
      "description": "0 normal; 1 shifted; no data until at least 20 samples",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "lk11-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
