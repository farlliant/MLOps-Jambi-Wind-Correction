# LK09 - Postgres (replace placeholder only in .env)
POSTGRES_DB=winddb
POSTGRES_USER=winduser
POSTGRES_PASSWORD=replace_with_a_strong_password

# LK09 - DagsHub MLflow Registry (replace token only in .env)
MLFLOW_TRACKING_URI=https://dagshub.com/farlliant/MLOps-Jambi-Wind-Correction.mlflow
MLFLOW_TRACKING_USERNAME=farlliant
MLFLOW_TRACKING_PASSWORD=replace_with_your_dagshub_token

MODEL_NAME=Jambi-Wind-Residual-RandomForest
MODEL_ALIAS=staging-candidate
