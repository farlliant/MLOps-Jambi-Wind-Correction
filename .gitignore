# ============================================
# Virtual Environment
# ============================================
.venv/
venv/
env/

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ============================================
# Environment / Secrets
# ============================================
.env
.env.*
*.key
*.pem

# ============================================
# IDE / Editor
# ============================================
.vscode/
.idea/

# ============================================
# OS Files
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# Generated Data
# ============================================
data/raw/*
data/processed/*
data/reports/*

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep

# Keep small raw samples for documentation/LK04
!data/raw/samples/
!data/raw/samples/**

# ============================================
# Logs / Cache
# ============================================
*.log
.pytest_cache/
.mypy_cache/
.cache/

# ============================================
# Build / Distribution
# ============================================
build/
dist/
*.egg-info/
# ============================================
# Intermediate Data
# ============================================
data/interim/*
!data/interim/.gitkeep

# ============================================
# Model Artifacts
# ============================================
models/*
!models/.gitkeep

# ============================================
# LK06 - MLflow Local Experiment Storage
# ============================================
mlflow.db*
mlartifacts/
mlruns/

# LK06 - Keep only experiment summaries in Git
!data/reports/lk06/
!data/reports/lk06/experiment_comparison.csv
!data/reports/lk06/best_model_metadata.json
# Local MLflow database and artifacts
mlflow-artifacts/


# LK06 - Track only experiment summaries
!data/reports/lk06/
data/reports/lk06/*
!data/reports/lk06/experiment_comparison.csv
!data/reports/lk06/best_model_metadata.json

# LK07 - Track verified registered-model inference evidence
!data/reports/lk07/
data/reports/lk07/*
!data/reports/lk07/inference_champion.json
